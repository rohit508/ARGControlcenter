# Copy this file to `.env.local` in this same server folder. Do not commit it.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-16-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-16-characters

# Required to turn on the live EDXSv2 HR dashboard integration.
EDXSV2_API_URL=http://localhost:YOUR_EDXSV2_API_PORT
EDXSV2_API_TOKEN=EDXSV2_SERVICE_ACCOUNT_JWT
EDXSV2_CLIENT_ID=YOUR_CLIENT_ID
EDXSV2_ENTITY_ID=YOUR_ENTITY_ID
